  "schemas": {
    "writeReport": {
      "type": "function",
      "function": {
        "name": "writeReport",
        "description": "输出可审阅研报，不编造缺失信息。",
        "parameters": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "sections": {
              "type": "array",
              "maxItems": 9,
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "content"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "title",
            "sections"
          ],
          "additionalProperties": false
        }
      }
    },
    "partTool": {
      "type": "function",
      "function": {
        "name": "analyzeDocumentPart",
        "description": "只根据本批原文分析，返回可核验引文和直接披露指标，不计算、不补造。",
        "parameters": {
          "type": "object",
          "properties": {
            "findings": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  },
                  "sourceId": {
                    "type": "string"
                  }
                },
                "required": [
                  "topic",
                  "text",
                  "quote",
                  "sourceId"
                ],
                "additionalProperties": false
              }
            },
            "metrics": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "properties": {
                  "metric": {
                    "type": "string",
                    "enum": [
                      "revenue",
                      "grossProfit",
                      "attributableProfit",
                      "grossMargin",
                      "operatingCashFlow",
                      "netMargin"
                    ]
                  },
                  "period": {
                    "type": "string"
                  },
                  "value": {
                    "type": "number"
                  },
                  "rawValue": {
                    "type": "string"
                  },
                  "unit": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string"
                  },
                  "sourceId": {
                    "type": "string"
                  }
                },
                "required": [
                  "metric",
                  "period",
                  "value",
                  "rawValue",
                  "unit",
                  "currency",
                  "scope",
                  "sourceId"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "findings",
            "metrics"
          ],
          "additionalProperties": false
        }
      }
    },
    "extractTool": {
      "type": "function",
      "function": {
        "name": "extractOperatingFacts",
        "description": "从本批文字提取直接披露的经营指标原值，不计算单季或比率。",
        "parameters": {
          "type": "object",
          "properties": {
            "facts": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "object",
                "properties": {
                  "company": {
                    "type": "string"
                  },
                  "metric": {
                    "type": "string"
                  },
                  "period": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "flow",
                      "stock",
                      "ratio",
                      "average"
                    ]
                  },
                  "value": {
                    "type": "number"
                  },
                  "rawValue": {
                    "type": "string"
                  },
                  "unit": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string"
                  },
                  "calendar": {
                    "type": "string"
                  },
                  "sourceId": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  }
                },
                "required": [
                  "company",
                  "metric",
                  "period",
                  "kind",
                  "value",
                  "rawValue",
                  "unit",
                  "currency",
                  "scope",
                  "calendar",
                  "sourceId",
                  "quote"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "facts"
          ],
          "additionalProperties": false
        }
      }
    },
    "alignmentTool": {
      "type": "function",
      "function": {
        "name": "alignOperatingMetrics",
        "description": "只提出相同经营指标的名称归并，不修改数字或期间。",
        "parameters": {
          "type": "object",
          "properties": {
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "factIds": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "factIds",
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "groups"
          ],
          "additionalProperties": false
        }
      }
    },
    "seriesTool": {
      "type": "function",
      "function": {
        "name": "extractSeries",
        "description": "从原文提取一个指标，禁止换算、插值或估算。",
