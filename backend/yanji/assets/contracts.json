    {
      "name": "analyzeDocuments",
      "description": "长上下文阅读全部上传报告的可提取文字，逐份建立有页码和原文引文的分析底稿；超长文本分批完整阅读，不仅是关键词检索。首次上传材料研究先调用此工具。",
      "parameters": {
        "type": "object",
        "properties": {
          "focus": {
            "type": "string"
          }
        },
        "required": [
