        "artifact.document-analysis",
        "source.document-chunk"
      ],
      "category": "analysis",
      "bootstrap": "documents"
    },
    {
      "name": "buildOperatingWorksheet",
      "description": "读取多份上传报告，按公司、业务指标、期间及单位对齐经营数据表；代码安全拆分累计流量的单季度。用户可点击任意指标画图、下载表格。",
      "parameters": {
        "type": "object",
        "properties": {
          "focus": {
            "type": "string"
          },
          "metrics": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "focus"
        ],
        "additionalProperties": false
