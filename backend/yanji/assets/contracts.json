        "session.documents"
      ],
      "produces": [
        "artifact.worksheet",
        "source.document-chunk"
      ],
      "category": "analysis",
      "bootstrap": "operating-metrics"
    },
    {
      "name": "calculate",
      "description": "确定性计算。growth输入本期、上期；负基数用subtract，不算常规增长率。",
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "sum",
              "subtract",
              "ratio",
              "growth",
              "percentage_points"
