          },
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "operation",
          "values",
          "sourceIds"
        ],
        "additionalProperties": false
      },
