    {
      "name": "deliverResearch",
      "description": "交付连贯的研究回答。summary直接回答问题；findings为0–5个自然章节，按需展开分析，关键数字在正文中链接原文；不强制套用卡片模板。",
      "parameters": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "findings": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "fact",
                    "inference",
                    "risk"
                  ]
                },
                "nextQuestions": {
                  "type": "array",
                  "maxItems": 2,
                  "items": {
                    "type": "string"
                  }
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "title",
                "body",
                "kind",
                "sourceIds"
              ],
              "additionalProperties": false
            }
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "summary",
          "findings",
          "gaps"
        ],
        "additionalProperties": false
      },
