        "documents",
        "external",
        "hybrid"
      ],
      "modes": [
        "research",
        "revision"
      ],
      "preconditions": [
        "evidence.observed"
      ],
      "produces": [
        "calculation.verified"
      ],
      "category": "verification"
    },
    {
