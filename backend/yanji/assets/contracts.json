    {
      "name": "createScenario",
      "description": "创建可编辑的收入与毛利假设沙盘。基准必须来自已查询财务数据，不预测评级或目标价。",
      "parameters": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "growth": {
            "type": "number",
            "description": "用户明确指定的收入增长率，百分数，例如5表示5%；未指定则省略"
          },
          "margin": {
            "type": "number",
            "description": "用户指定的毛利率，百分数；未指定则省略"
          },
          "years": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "测算年数，明年为1；未指定则省略"
          }
        },
        "required": [
          "sourceId"
        ],
        "additionalProperties": false
      },
      "sourceModes": [
        "documents",
        "external",
        "hybrid"
      ],
      "modes": [
        "research",
        "revision"
      ],
      "preconditions": [
        "source.annual-financials.observed"
      ],
      "produces": [
        "artifact.scenario",
        "source.user-assumptions"
      ],
      "category": "analysis"
    },
    {
      "name": "planResearch",
      "description": "复杂研究开始时保存目标、研究步骤和资料缺口；此计划不是已完成结果。",
      "parameters": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string"
            }
          },
          "gaps": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string"
                },
                "dimension": {
                  "type": "string",
                  "enum": [
                    "temporal",
                    "comparison",
                    "deep_dive",
                    "market"
                  ]
                }
              },
              "required": [
                "question",
                "dimension"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "goal",
          "steps",
          "gaps"
        ],
        "additionalProperties": false
      },
      "sourceModes": [
        "documents",
