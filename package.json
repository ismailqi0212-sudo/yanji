{
  "name": "yanji-chat",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "PYTHONPATH=backend YANJI_RELOAD=1 .venv/bin/python -m yanji",
    "build": "tsc -b && vite build",
    "start": "PYTHONPATH=backend .venv/bin/python -m yanji",
    "test": ".venv/bin/python -m pytest -q",
    "test:legacy": "node --test tests/*.test.mjs",
    "start:legacy": "NODE_ENV=production node server/index.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 4321",
    "lint:python": ".venv/bin/ruff check backend python_tests --select F"
  },
  "dependencies": {
    "@heroui/react": "^2.8.0",
    "@phosphor-icons/react": "^2.1.7",
    "@tailwindcss/vite": "^4.1.0",
    "express": "^5.1.0",
    "framer-motion": "^12.0.0",
    "jsonrepair": "^3.15.0",
    "lightweight-charts": "^5.2.1",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "opencc-js": "^1.4.2",
    "pdfjs-dist": "^5.4.149",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
